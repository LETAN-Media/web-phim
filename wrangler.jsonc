{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "web-phim",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [],
  "vars": {
    "ENABLE_LEGACY_VIDEO_FALLBACK": "true",
    "LEGACY_ORIGIN": "https://phim.callboy76.live",
    "ENABLE_NEW_TELEGRAM_GATEWAY": "true",
    "ENABLE_LEGACY_FALLBACK": "true",
    "GATEWAY_ORIGIN": "https://p01--telegram-stream-gateway--r4v2pzg2klvq.code.run",
    "CHANNEL_CHAT_ID": "-1003952062608",
    "URL_TTL_SECONDS": "21600"
  },
  "observability": {
    "enabled": true
  }
}
